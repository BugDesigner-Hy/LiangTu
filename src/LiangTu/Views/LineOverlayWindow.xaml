<Window x:Class="LiangTu.Views.LineOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="晾图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="True">
  <Canvas x:Name="RootCanvas" Background="{x:Null}" ClipToBounds="False">
    <!-- Hemp clothesline -->
    <Path x:Name="Rope"
          Stroke="#C4A06A" StrokeThickness="3.2"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          IsHitTestVisible="False">
      <Path.Effect>
        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
      </Path.Effect>
    </Path>
    <!-- Soft under-strand for thickness -->
    <Path x:Name="RopeShade"
          Stroke="#80604A28" StrokeThickness="1.4"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          IsHitTestVisible="False"/>

    <!-- Left end: wooden wall cleat + metal eye + rope knot -->
    <Canvas x:Name="RopeCapL" Width="40" Height="34" Canvas.Top="2" Cursor="SizeAll"
            ToolTip="拖动绳子到其他屏幕">
      <Canvas.Effect>
        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35"/>
      </Canvas.Effect>
      <Border x:Name="CapLPlate" Width="12" Height="30" Canvas.Left="2" Canvas.Top="2" CornerRadius="2"
              Background="#B8895A" BorderBrush="#6E4524" BorderThickness="1"/>
      <Border Width="3" Height="26" Canvas.Left="4" Canvas.Top="4" CornerRadius="1"
              Background="#40FFFFFF" BorderThickness="0"/>
      <Ellipse Width="3" Height="3" Canvas.Left="6.5" Canvas.Top="6" Fill="#5A3A1E"/>
      <Ellipse Width="3" Height="3" Canvas.Left="6.5" Canvas.Top="24" Fill="#5A3A1E"/>
      <Ellipse x:Name="CapLCleat" Width="10" Height="10" Canvas.Left="10" Canvas.Top="12"
               Fill="#C9A06A" Stroke="#6E4524" StrokeThickness="1"/>
      <Ellipse Width="14" Height="14" Canvas.Left="16" Canvas.Top="10"
               Stroke="#9A9A9A" StrokeThickness="2.2" Fill="#00000000"/>
      <Ellipse Width="8" Height="8" Canvas.Left="19" Canvas.Top="13"
               Stroke="#6E6E6E" StrokeThickness="1" Fill="#00000000"/>
      <Ellipse x:Name="CapLKnot" Width="13" Height="11" Canvas.Left="18" Canvas.Top="14"
               Fill="#A67C52" Stroke="#6B4F2A" StrokeThickness="0.9"/>
      <Ellipse x:Name="CapLKnotHi" Width="7" Height="6" Canvas.Left="21" Canvas.Top="16"
               Fill="#C4966A" Stroke="#8A6238" StrokeThickness="0.6"/>
      <Path x:Name="CapLStub" Stroke="#A67C52" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M 30,19 L 38,18" IsHitTestVisible="False"/>
    </Canvas>

    <!-- Right end (mirrored) -->
    <Canvas x:Name="RopeCapR" Width="40" Height="34" Canvas.Top="2" Cursor="SizeAll"
            ToolTip="拖动绳子到其他屏幕">
      <Canvas.Effect>
        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35"/>
      </Canvas.Effect>
      <Border x:Name="CapRPlate" Width="12" Height="30" Canvas.Left="26" Canvas.Top="2" CornerRadius="2"
              Background="#B8895A" BorderBrush="#6E4524" BorderThickness="1"/>
      <Border Width="3" Height="26" Canvas.Left="33" Canvas.Top="4" CornerRadius="1"
              Background="#40FFFFFF" BorderThickness="0"/>
      <Ellipse Width="3" Height="3" Canvas.Left="30.5" Canvas.Top="6" Fill="#5A3A1E"/>
      <Ellipse Width="3" Height="3" Canvas.Left="30.5" Canvas.Top="24" Fill="#5A3A1E"/>
      <Ellipse x:Name="CapRCleat" Width="10" Height="10" Canvas.Left="20" Canvas.Top="12"
               Fill="#C9A06A" Stroke="#6E4524" StrokeThickness="1"/>
      <Ellipse Width="14" Height="14" Canvas.Left="10" Canvas.Top="10"
               Stroke="#9A9A9A" StrokeThickness="2.2" Fill="#00000000"/>
      <Ellipse Width="8" Height="8" Canvas.Left="13" Canvas.Top="13"
               Stroke="#6E6E6E" StrokeThickness="1" Fill="#00000000"/>
      <Ellipse x:Name="CapRKnot" Width="13" Height="11" Canvas.Left="9" Canvas.Top="14"
               Fill="#A67C52" Stroke="#6B4F2A" StrokeThickness="0.9"/>
      <Ellipse x:Name="CapRKnotHi" Width="7" Height="6" Canvas.Left="12" Canvas.Top="16"
               Fill="#C4966A" Stroke="#8A6238" StrokeThickness="0.6"/>
      <Path x:Name="CapRStub" Stroke="#A67C52" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M 2,18 L 10,19" IsHitTestVisible="False"/>
    </Canvas>

    <!-- Empty-line compact knot (centered); drag to move monitor -->
    <Canvas x:Name="RopeKnot" Width="36" Height="36" Visibility="Collapsed" Cursor="SizeAll"
            ToolTip="空绳子（靠右）· 拖到其他屏幕 · 截图后自动展开">
      <Canvas.Effect>
        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.4"/>
      </Canvas.Effect>
      <Ellipse x:Name="KnotRingOuter" Width="28" Height="28" Canvas.Left="4" Canvas.Top="4"
               Stroke="#8B6238" StrokeThickness="3.5" Fill="#00000000"/>
      <Ellipse x:Name="KnotRingInner" Width="20" Height="20" Canvas.Left="8" Canvas.Top="8"
               Stroke="#C4966A" StrokeThickness="3" Fill="#00000000"/>
      <Ellipse x:Name="KnotCore" Width="14" Height="12" Canvas.Left="11" Canvas.Top="12"
               Fill="#A67C52" Stroke="#6B4F2A" StrokeThickness="1"/>
      <Ellipse x:Name="KnotCoreHi" Width="7" Height="6" Canvas.Left="14.5" Canvas.Top="14.5"
               Fill="#D2A06A" Stroke="#8A6238" StrokeThickness="0.6"/>
      <Border x:Name="KnotPeg" Width="6" Height="10" Canvas.Left="15" Canvas.Top="0" CornerRadius="1"
              Background="#B8895A" BorderBrush="#6E4524" BorderThickness="0.8"/>
    </Canvas>

    <!-- Rope-end charms (multi; decorative; not hit-test) -->
    <Canvas x:Name="CharmHost" IsHitTestVisible="False"/>

    <!-- One-click fold / expand all photos on the rope -->
    <Border x:Name="FoldButton" Width="44" Height="22" CornerRadius="11" Cursor="Hand"
            Background="#E8F5F0E6" BorderBrush="#99FFFFFF" BorderThickness="1"
            Visibility="Collapsed" Canvas.Top="8" Canvas.Left="56"
            ToolTip="折叠或展开绳子上的全部截图"
            MouseLeftButtonUp="FoldButton_OnClick">
      <TextBlock x:Name="FoldButtonText" Text="折叠" FontSize="11" FontWeight="SemiBold"
                 Foreground="#5C4033" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>

    <Canvas x:Name="CardsHost" Background="{x:Null}"/>

    <!-- Overflow / folded stack — hung on the rope with a clothespin -->
    <Canvas x:Name="OverflowBadge" Width="64" Height="100" Cursor="Hand"
            Visibility="Collapsed" Canvas.Top="8"
            ToolTip="点击展开"
            MouseLeftButtonUp="OverflowBadge_OnClick">
      <!-- Wooden clothespin gripping the rope -->
      <Canvas Width="22" Height="28" Canvas.Left="21" Canvas.Top="0" IsHitTestVisible="False">
        <Canvas.Effect>
          <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
        </Canvas.Effect>
        <Path Fill="#D2A06A" Stroke="#8B5E34" StrokeThickness="0.8"
              Data="M 4,2 L 8,2 L 9,16 L 7,26 L 4,26 L 5,16 Z"/>
        <Path Fill="#C4925A" Stroke="#8B5E34" StrokeThickness="0.8"
              Data="M 14,2 L 18,2 L 17,16 L 18,26 L 15,26 L 13,16 Z"/>
        <Ellipse Canvas.Left="7" Canvas.Top="11" Width="8" Height="8"
                 Fill="#B0B0B0" Stroke="#6E6E6E" StrokeThickness="0.8"/>
        <Ellipse Canvas.Left="9" Canvas.Top="13" Width="4" Height="4"
                 Fill="#D8D8D8" Stroke="#8A8A8A" StrokeThickness="0.5"/>
        <Path Fill="#40FFFFFF" Data="M 5,3 L 7.5,3 L 8,14 L 6,14 Z"/>
      </Canvas>
      <!-- Photo stack clamped under the pin -->
      <Border Width="56" Height="72" Canvas.Left="4" Canvas.Top="20" CornerRadius="6"
              Background="#EEF5F5F5" BorderBrush="#99FFFFFF" BorderThickness="1.5">
        <Border.Effect>
          <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
          <Border x:Name="OverflowBack2" Width="44" Height="56" CornerRadius="4" Background="#DDDDDD"
                  BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,8,8"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <RotateTransform Angle="-8"/>
            </Border.RenderTransform>
          </Border>
          <Border x:Name="OverflowBack1" Width="44" Height="56" CornerRadius="4" Background="#EEEEEE"
                  BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,4,4"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <RotateTransform Angle="-3"/>
            </Border.RenderTransform>
          </Border>
          <Border Width="44" Height="56" CornerRadius="4" Background="#F7F7F7"
                  BorderBrush="#BBBBBB" BorderThickness="1"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Image x:Name="OverflowThumb" Stretch="Uniform" Margin="3"/>
          </Border>
          <Border Background="#DD2E7D32" CornerRadius="10" Padding="6,1"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-6">
            <TextBlock x:Name="OverflowCountText" Text="+0" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
          </Border>
        </Grid>
      </Border>
    </Canvas>

    <Popup x:Name="OverflowPopup" AllowsTransparency="True" StaysOpen="False"
           Placement="Bottom" PlacementTarget="{Binding ElementName=OverflowBadge}"
           HorizontalOffset="-40" VerticalOffset="6"
           Opened="OverflowPopup_OnOpened" Closed="OverflowPopup_OnClosed">
      <Border Background="#F2FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8"
              MaxWidth="420" MaxHeight="280">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35"/>
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <WrapPanel x:Name="OverflowPanel" Width="400"/>
        </ScrollViewer>
      </Border>
    </Popup>
  </Canvas>
</Window>
