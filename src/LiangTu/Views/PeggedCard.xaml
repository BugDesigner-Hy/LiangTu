<UserControl x:Class="LiangTu.Views.PeggedCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="148" Height="178"
             Cursor="Hand"
             Focusable="True">
  <UserControl.RenderTransform>
    <TransformGroup>
      <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" CenterX="74" CenterY="20"/>
      <RotateTransform x:Name="TiltTransform" Angle="0" CenterX="74" CenterY="12"/>
      <TranslateTransform x:Name="SwingTransform"/>
      <TranslateTransform x:Name="DismissTransform"/>
    </TransformGroup>
  </UserControl.RenderTransform>
  <UserControl.ContextMenu>
    <ContextMenu>
      <MenuItem Header="复制" Click="MenuCopy_OnClick"/>
      <MenuItem x:Name="PinMenu" Header="固定在前排" Click="MenuPin_OnClick"/>
      <MenuItem Header="重命名…" Click="MenuRename_OnClick"/>
      <MenuItem Header="打开" Click="MenuOpen_OnClick"/>
      <MenuItem Header="用画图编辑" Click="MenuEdit_OnClick"/>
      <MenuItem Header="在文件夹中显示" Click="MenuReveal_OnClick"/>
      <Separator/>
      <MenuItem Header="从绳子上取下" Click="MenuTakeDown_OnClick"/>
      <MenuItem Header="删除到回收站" Click="MenuTrash_OnClick"/>
    </ContextMenu>
  </UserControl.ContextMenu>
  <Grid>
    <!-- Clip on rope — click to unclip / discard -->
    <Canvas x:Name="PinRoot" Width="22" Height="28" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,-2,0,0" Panel.ZIndex="3" IsHitTestVisible="True"
            Cursor="Hand" ToolTip="点击衣夹取下"
            PreviewMouseLeftButtonDown="PinRoot_OnPreviewDown">
      <Canvas.RenderTransform>
        <TranslateTransform x:Name="PinLift"/>
      </Canvas.RenderTransform>
      <Canvas.Effect>
        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
      </Canvas.Effect>
      <!-- Larger invisible hit pad -->
      <Rectangle Width="36" Height="36" Canvas.Left="-7" Canvas.Top="-4"
                 Fill="#01FFFFFF" IsHitTestVisible="True"/>

      <!-- Classic two-jaw peg -->
      <Canvas x:Name="PegClassicGroup">
        <Path x:Name="JawL" Fill="#D2A06A" Stroke="#8B5E34" StrokeThickness="0.8"
              Data="M 4,2 L 8,2 L 9,16 L 7,26 L 4,26 L 5,16 Z">
          <Path.RenderTransform>
            <RotateTransform x:Name="JawLRot" Angle="0" CenterX="6.5" CenterY="12"/>
          </Path.RenderTransform>
        </Path>
        <Path x:Name="JawR" Fill="#C4925A" Stroke="#8B5E34" StrokeThickness="0.8"
              Data="M 14,2 L 18,2 L 17,16 L 18,26 L 15,26 L 13,16 Z">
          <Path.RenderTransform>
            <RotateTransform x:Name="JawRRot" Angle="0" CenterX="15.5" CenterY="12"/>
          </Path.RenderTransform>
        </Path>
        <Ellipse x:Name="SpringOuter" Canvas.Left="7" Canvas.Top="11" Width="8" Height="8"
                 Fill="#B0B0B0" Stroke="#6E6E6E" StrokeThickness="0.8"/>
        <Ellipse x:Name="SpringInner" Canvas.Left="9" Canvas.Top="13" Width="4" Height="4"
                 Fill="#D8D8D8" Stroke="#8A8A8A" StrokeThickness="0.5"/>
        <Path x:Name="JawHighlight" Fill="#40FFFFFF" Data="M 5,3 L 7.5,3 L 8,14 L 6,14 Z" IsHitTestVisible="False"/>
      </Canvas>

      <!-- 小夹子：宽底 + 中孔 + 顶钮（参考图） -->
      <Canvas x:Name="SmallClipGroup" Visibility="Collapsed" Width="28" Height="24">
        <Canvas.RenderTransform>
          <ScaleTransform x:Name="SmallClipScale" ScaleX="1" ScaleY="1" CenterX="14" CenterY="10"/>
        </Canvas.RenderTransform>
        <Path x:Name="SmallBody" StrokeThickness="1.6" StrokeLineJoin="Round"
              Data="M 10,3.2 C 10,1.6 11.2,0.6 14,0.6 C 16.8,0.6 18,1.6 18,3.2
                    L 18,7 L 22,11 L 24,16 L 24,20 L 4,20 L 4,16 L 6,11 L 10,7 Z"/>
        <Ellipse x:Name="SmallHole" Canvas.Left="10.5" Canvas.Top="8" Width="7" Height="7"
                 StrokeThickness="1.4"/>
        <Rectangle x:Name="SmallStrip" Canvas.Left="5" Canvas.Top="18.2" Width="18" Height="1.6"
                   RadiusX="0.4" RadiusY="0.4"/>
      </Canvas>

      <!-- 长尾夹 / binder clip（参考图） -->
      <Canvas x:Name="BinderGroup" Visibility="Collapsed" Width="36" Height="34">
        <Path x:Name="BinderHandleL" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Fill="Transparent"
              Data="M 12,16 C 8,14 5,10 5,6 C 5,3 7,1.5 9.5,1.5 C 12,1.5 13.5,3.5 13.5,6 L 13.5,16">
          <Path.RenderTransform>
            <RotateTransform x:Name="BinderHandleLRot" Angle="0" CenterX="12" CenterY="16"/>
          </Path.RenderTransform>
        </Path>
        <Path x:Name="BinderHandleR" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Fill="Transparent"
              Data="M 24,16 C 28,14 31,10 31,6 C 31,3 29,1.5 26.5,1.5 C 24,1.5 22.5,3.5 22.5,6 L 22.5,16">
          <Path.RenderTransform>
            <RotateTransform x:Name="BinderHandleRRot" Angle="0" CenterX="24" CenterY="16"/>
          </Path.RenderTransform>
        </Path>
        <Path x:Name="BinderBody" StrokeThickness="1.4" StrokeLineJoin="Round"
              Data="M 8,15 L 28,15 L 27,30 L 9,30 Z"/>
        <Path x:Name="BinderBodyShade" StrokeThickness="0" IsHitTestVisible="False"
              Data="M 22,15.5 L 27.5,15.5 L 26.6,29.5 L 22,29.5 Z"/>
        <Path x:Name="BinderHighlight" Fill="#66FFFFFF" StrokeThickness="0" IsHitTestVisible="False"
              Data="M 10,16.5 L 16,16.5 L 15.5,20 L 10.5,20 Z"/>
        <Rectangle x:Name="BinderHinge1" Canvas.Left="10" Canvas.Top="29.5" Width="4.5" Height="3.2" RadiusX="0.5" RadiusY="0.5"
                   StrokeThickness="1"/>
        <Rectangle x:Name="BinderHinge2" Canvas.Left="15.8" Canvas.Top="29.5" Width="4.5" Height="3.2" RadiusX="0.5" RadiusY="0.5"
                   StrokeThickness="1"/>
        <Rectangle x:Name="BinderHinge3" Canvas.Left="21.5" Canvas.Top="29.5" Width="4.5" Height="3.2" RadiusX="0.5" RadiusY="0.5"
                   StrokeThickness="1"/>
      </Canvas>
    </Canvas>
    <Border x:Name="Frame" Margin="8,18,8,8" CornerRadius="6" BorderBrush="#99FFFFFF" BorderThickness="1.5"
            Background="#EEF5F5F5" Padding="4">
      <Border.Effect>
        <DropShadowEffect x:Name="FrameShadow" BlurRadius="14" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
      </Border.Effect>
      <Grid>
        <Image x:Name="ThumbImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               IsHitTestVisible="False"/>
        <!-- Tape corners (Tape photo style) -->
        <Border x:Name="TapeTL" Width="28" Height="10" CornerRadius="1"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-2,0,0"
                Background="#AAF0D880" BorderBrush="#66C0A060" BorderThickness="0.5"
                RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
          <Border.RenderTransform>
            <RotateTransform Angle="-28"/>
          </Border.RenderTransform>
        </Border>
        <Border x:Name="TapeTR" Width="28" Height="10" CornerRadius="1"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                Background="#AAF0D880" BorderBrush="#66C0A060" BorderThickness="0.5"
                RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
          <Border.RenderTransform>
            <RotateTransform Angle="28"/>
          </Border.RenderTransform>
        </Border>
        <Border x:Name="PinBadge" Width="18" Height="18" CornerRadius="9"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0"
                Background="#E6C9A227" Visibility="Collapsed" IsHitTestVisible="False"
                ToolTip="已固定在前排">
          <TextBlock Text="钉" FontSize="10" Foreground="White" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="NameLabel" Text="" FontSize="10" Foreground="#DD333333"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"
                   HorizontalAlignment="Center" Margin="2,0,2,2" IsHitTestVisible="False"/>
      </Grid>
    </Border>
    <Border x:Name="CopiedBadge" Background="#CC2E7D32" CornerRadius="4" Padding="8,3"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock Text="已复制" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
    </Border>
    <!-- Hint while dragging: reorder / throw away -->
    <Border x:Name="DragHint" Background="#CC2E5A8C" CornerRadius="4" Padding="8,3"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0"
            Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock x:Name="DragHintText" Text="" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
    </Border>
  </Grid>
</UserControl>
